{
  "name": "dsh-loop-dock",
  "version": "0.1.0",
  "private": false,
  "description": "A loop dock for DeepSeek Harness: one harness, multiple agent loops.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./hub": "./src/hub.mjs",
    "./registry": "./src/registry.mjs",
    "./selection": "./src/selection.mjs",
    "./provider": "./src/provider.mjs",
    "./errors": "./src/errors.mjs",
    "./default-driver": "./src/default-driver.mjs",
    "./headless-driver": "./src/headless-driver-plugin.mjs",
    "./config": "./src/config.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "DESIGN.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "vendor",
    "scripts",
    "client.js"
  ],
  "scripts": {
    "prepack": "npm run check",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs && node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-loop",
    "multi-agent",
    "heterogeneous-agent-loops",
    "llm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
